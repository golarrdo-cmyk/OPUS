# Токен бота от @BotFather
BOT_TOKEN=
# Ключ Anthropic API (console.anthropic.com)
ANTHROPIC_API_KEY=
# Модель для распознавания и советов. По умолчанию claude-opus-5-5,
# дешевле в ~4 раза: claude-haiku-4-5
MODEL=claude-opus-5-5
# Сколько фото можно распознать бесплатно до оплаты
FREE_PHOTOS=5
DB_PATH=dietbot.sqlite3
